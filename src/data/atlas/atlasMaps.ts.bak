export type AtlasMarker = {
  id: string;
  title: string;
  subtitle?: string;
  x: number;
  y: number;
  description: string;
  references: string[];
};

export type AtlasRoutePoint = {
  x: number;
  y: number;
};

export type AtlasRoute = {
  id: string;
  title: string;
  color: string;
  points: AtlasRoutePoint[];
};

export type AtlasMap = {
  id: string;
  title: string;
  subtitle: string;
  category: string;
  period: string;
  summary: string;
  imageKey: string;
  references: string[];
  markers: AtlasMarker[];
  routes: AtlasRoute[];
};

